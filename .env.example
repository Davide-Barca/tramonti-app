# Public URL of the site (canonical, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express API base URL (server-only, never NEXT_PUBLIC_).
API_URL=http://localhost:4000

# iubenda document ids (server-only). Privacy and cookie policy share the policy id.
IUBENDA_POLICY_ID=
IUBENDA_TERMS_ID=
